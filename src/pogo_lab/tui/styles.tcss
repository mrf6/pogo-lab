Screen {
    background: $background;
}

/* Home Screen */
#home-container {
    width: 100%;
    height: 1fr;
    align: center middle;
    content-align: center middle;
    padding: 2;
}

#home-logo {
    width: auto;
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

#home-subtitle {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
}

#home-menu {
    width: 36;
    height: auto;
    border: round $primary-background;
    background: $surface;
    padding: 1 2;
}

.menu-item {
    width: 100%;
    padding: 1 2;
    margin-bottom: 1;
    background: $panel;
    color: $text;
    text-style: bold;
}

.menu-item.-selected {
    background: $primary;
    color: $text;
}

.menu-item:hover {
    background: $primary;
}

.menu-item.-disabled {
    color: $text-muted;
    text-style: dim;
    margin-bottom: 0;
}

.menu-item.-disabled.-selected {
    background: $boost;
    color: $text-muted;
}

.menu-item.-disabled:hover {
    background: $panel;
}

#home-hint {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

/* Rank Checker Screen */
#league-bar {
    height: auto;
    padding: 1 1 0 1;
    align-vertical: middle;
}

.league-pill {
    width: auto;
    padding: 0 2;
    margin-right: 1;
    background: $surface;
}

.league-great {
    color: #3B82F6;
}

.league-great.-active {
    background: #3B82F6;
    color: #FFFFFF;
    text-style: bold;
}

.league-ultra {
    color: #EAB308;
}

.league-ultra.-active {
    background: #EAB308;
    color: #000000;
    text-style: bold;
}

.league-master {
    color: #A855F7;
}

.league-master.-active {
    background: #A855F7;
    color: #FFFFFF;
    text-style: bold;
}

#top-panel {
    height: auto;
    padding: 1 1 0 1;
}

#inputs-column {
    width: 30%;
    min-width: 28;
    max-width: 44;
    height: auto;
    margin-right: 1;
}

.field-label {
    color: $text-muted;
    margin-bottom: 0;
}

#lookup-label {
    margin-top: 1;
}

#species-suggestions {
    display: none;
    position: absolute;
    overlay: screen;
    height: auto;
    max-height: 8;
    border: round $primary;
    background: $surface;
}

#species-suggestions.-visible {
    display: block;
}

#summary-card {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    background: $surface;
    border: round $primary-background;
}

#rank-table {
    height: 1fr;
    margin: 1;
    border: round $primary-background;
}
